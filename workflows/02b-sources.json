      "id": "ca313e33-1427-4d04-a941-7c97fd98c55e",
      "name": "Fetch SANS ISC"
    },
    {
      "parameters": {
        "jsCode": "const clean = (s) => (s || '')\n  .replace(/&nbsp;/g, ' ')\n  .replace(/&amp;/g, '&')\n  .replace(/&quot;/g, '\"')\n  .replace(/&#39;/g, \"'\")\n  .replace(/\\s+/g, ' ')\n  .trim();\n\n// removes the trailing date tag, e.g. \", (Tue, Nov 17th)\"\nconst stripDateTag = (t) =>\n  t.replace(/,?\\s*\\([A-Z][a-z]{2}, [A-Z][a-z]{2} \\d{1,2}(st|nd|rd|th)\\)\\s*$/, '');\n\nreturn $input.all()\n  .map(item => item.json)\n  .filter(d => d.link && d.title && (d.isoDate || d.pubDate))\n  .filter(d => !/^ISC Stormcast/i.test(d.title.trim()))\n  .map(d => ({\n    json: {\n      id: d.link,\n      title: stripDateTag(clean(d.title)),\n      url: d.link,\n      source: 'SANS ISC',\n      type: 'research',\n      published_at: new Date(d.isoDate || d.pubDate).toISOString(),\n      content: clean(d.contentSnippet).slice(0, 500)\n    }\n  }));"
      },
      "type": "n8n-nodes-base.code",

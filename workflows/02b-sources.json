      "name": "Fetch Talos"
    },
    {
      "parameters": {
        "jsCode": "const clean = (s) => (s || '')\n  .replace(/&nbsp;/g, ' ')\n  .replace(/&amp;/g, '&')\n  .replace(/&quot;/g, '\"')\n  .replace(/&#39;/g, \"'\")\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nreturn $input.all()\n  .map(item => item.json)\n  .filter(d => d.link && d.title && (d.isoDate || d.pubDate))\n  .map(d => ({\n    json: {\n      id: d.link,\n      title: clean(d.title),\n      url: d.link,\n      source: 'Cisco Talos',\n      type: 'research',\n      published_at: new Date(d.isoDate || d.pubDate).toISOString(),\n      content: clean(d.contentSnippet).slice(0, 500)\n    }\n  }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [

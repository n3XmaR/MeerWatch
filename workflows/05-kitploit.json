    {
      "parameters": {
        "jsCode": "const clean = (s) => (s || '')\n  .replace(/&nbsp;/g, ' ')\n  .replace(/&amp;/g, '&')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nreturn $input.all()\n  .map(item => item.json)\n  .filter(d => d.link && d.title && (d.isoDate || d.pubDate))\n  .map(d => ({\n    json: {\n      id: d.link,\n      title: clean(d.title),\n      url: d.link,\n      source: 'PortSwigger Research',\n      type: 'research',\n      published_at: new Date(d.isoDate || d.pubDate).toISOString(),\n      content: clean(d.contentSnippet)\n    }\n  }));"
      },
      "type": "n8n-nodes-base.code",

        "jsCode": "const decode = (s) => s\n  .replace(/&#x27;|&#39;/g, \"'\")\n  .replace(/&quot;/g, '\"')\n  .replace(/&lt;/g, '<')\n  .replace(/&gt;/g, '>')\n  .replace(/&nbsp;/g, ' ')\n  .replace(/&amp;/g, '&');\n\n// remove tags first, then decode entities (order matters)\nconst clean = (s) => decode(\n  String(s || '')\n    .replace(/<img[^>]*>/gi, ' ')\n    .replace(/<[^>]+>/g, ' ')\n).replace(/\\s+/g, ' ').trim();\n\nreturn $input.all()\n  .map(item => item.json)\n  .filter(d => d.link && d.title && d.pubDate && !isNaN(new Date(d.pubDate)))\n  .filter(d => !/updated!?\\s*$/i.test(clean(d.title)))   // skip \"— Updated!\" noise\n  .map(d => {\n    const name = clean(d.title);\n    const isNewTool = d.link.includes('/en/tools/');\n    return {\n      json: {\n        id: d.link,\n        title: (isNewTool ? 'New tool: ' : 'Release: ') + name,\n        url: d.link,\n        source: 'Kitploit',\n        type: 'tool',\n        published_at: new Date(d.pubDate).toISOString(),\n        content: clean(d.description)\n      }\n    };\n  });"

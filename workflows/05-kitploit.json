      "position": [
        688,
        1760
      ],
      "id": "ca313e33-1427-4d04-a941-7c97fd98c55e",
      "name": "Fetch SANS ISC",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const clean = (s) => (s || '')\n  .replace(/&nbsp;/g, ' ')\n  .replace(/&amp;/g, '&')\n  .replace(/&quot;/g, '\"')\n  .replace(/&#39;/g, \"'\")\n  .replace(/\\s+/g, ' ')\n  .trim();\n\n// removes the trailing date tag, e.g. \", (Tue, Nov 17th)\"\nconst stripDateTag = (t) =>\n  t.replace(/,?\\s*\\([A-Z][a-z]{2}, [A-Z][a-z]{2} \\d{1,2}(st|nd|rd|th)\\)\\s*$/, '');\n\nreturn $input.all()\n  .map(item => item.json)\n  .filter(d => d.link && d.title && (d.isoDate || d.pubDate))\n  .filter(d => !/^ISC Stormcast/i.test(d.title.trim()))\n  .map(d => ({\n    json: {\n      id: d.link,\n      title: stripDateTag(clean(d.title)),\n      url: d.link,\n      source: 'SANS ISC',\n      type: 'research',\n      published_at: new Date(d.isoDate || d.pubDate).toISOString(),\n      content: clean(d.contentSnippet).slice(0, 500)\n    }\n  }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        912,
        1760
      ],
      "id": "ef7ffa18-f958-4eee-8a00-987fa900e3e2",
      "name": "Normalize SANS ISC"
    },
    {
      "parameters": {
        "jsCode": "const CONFIG = {\n  baseBySource: {\n    'CISA KEV': 7,\n    'PortSwigger Research': 7,\n    'Cisco Talos': 5,\n    'SANS ISC': 4,\n    'Krebs on Security': 5,\n    'BleepingComputer': 4,\n    'The Hacker News': 4,\n    'SecurityWeek': 4,\n    'Kitploit': 3,\n  },\n  defaultBase: 4,\n  maxBySource: { 'Kitploit': 6 },\n\n  boosts: [\n    { re: /zero[- ]day|0-day/, pts: 3 },\n    { re: /actively exploited|exploited in the wild|in the wild|known exploited|\\bkev\\b/, pts: 3 },\n    { re: /\\brce\\b|remote code execution/, pts: 2 },\n    { re: /\\bcritical\\b/, pts: 1 },\n    { re: /\\bcvss (score: )?(9|10)/, pts: 1 },\n    { re: /ransomware/, pts: 1 },\n    { re: /\\bcve-\\d{4}-\\d{4,}/, pts: 1 },\n    { re: /patch tuesday|infocon/, pts: 2 },\n    { re: /backdoor|supply[- ]chain/, pts: 1 },\n    { re: /data breach|breach(ed)?/, pts: 1 },\n    { re: /espionage|china-linked|china-nexus|state-sponsored|\\bapt\\d*\\b/, pts: 1 },\n  ],\n\n  penalties: [\n    { re: /webinar|sponsored|\\bawards?\\b|partnership|partners with/, pts: -3 },\n    { re: /threat source newsletter/, pts: -2 },\n    { re: /guest diary/, pts: -2 },\n    { re: /\\bhow to\\b|tutorial|step[- ]by[- ]step/, pts: -1 },\n    { re: /\\bpricing\\b|launches|announces (new|the)/, pts: -1 },\n    { re: /\\bcvss (score: )?[0-4]\\.\\d/, pts: -2 },\n    { re: /nordpass|1password|bitwarden|flying blind|you('|’)re missing/, pts: -3 },\n    { re: /survey|a16z|report finds|feedback friday|in other news/, pts: -1 },\n    { re: /physical access/, pts: -2 },\n  ],\n\n  sourceRules: [\n    { source: 'PortSwigger Research', re: /top 10 web hacking/i, pts: -2 },\n  ],\n\n  recency: [\n    { maxHours: 24, pts: 1 },\n  ],\n\n  categories: [\n    { name: 'Exploit/Zero-day', re: /zero[- ]day|0-day|actively exploited|active exploitation|exploited in the wild|known exploited/ },\n    { name: 'Malware/Ransomware', re: /ransomware|malware|trojan|botnet|infostealer|stealer|backdoor|loader|\\brat\\b/ },\n    { name: 'Breach/Incident', re: /breach|data leak|leaked|\\bhack(ed|ers?)?\\b|compromised (systems|network|servers?)|stolen|stole|cyberattack|cyber attack/ },\n    { name: 'Vulnerability', re: /\\bcve-\\d{4}-\\d{4,}|vulnerabilit|patch|flaw|security update/ },\n    { name: 'Research', re: /researchers (have )?(show|demonstrat|disclos|found|discover)|proof-of-concept|\\bpoc\\b/ },\n    { name: 'Tool', re: /open[- ]source tool|new tool|github|framework/ },\n    { name: 'Policy/Other', re: /\\blaw\\b|regulation|fine[sd]?\\b|arrest|sentenced|indicted|gdpr|congress|sanctions/ },\n  ],\n  categoryByType: { vuln: 'Vulnerability', research: 'Research', news: 'Policy/Other', tool: 'Tool' },\n\n  summaryLength: 200,\n};\n\nfunction cleanText(s) {\n  return String(s || '')\n    .replace(/<[^>]*>/g, ' ')\n    .replace(/&nbsp;/g, ' ')\n    .replace(/&amp;/g, '&')\n    .replace(/&lt;/g, '<').replace(/&gt;/g, '>')\n    .replace(/&quot;/g, '\"').replace(/&#0?39;/g, \"'\")\n    .replace(/&#\\d+;|&[a-z]+;/gi, ' ')\n    .replace(/\\\\[nrt]/g, ' ')\n    .replace(/\\[(?:…|\\.\\.\\.)\\]|\\[&#8230;\\]/g, '')\n    .replace(/\\s+/g, ' ')\n    .replace(/\\s*The post .* appeared first on .*$/i, '')\n    .trim();\n}\n\nfunction makeSummary(text, max) {\n  if (text.length <= max) return text;\n  const cut = text.slice(0, max);\n  const lastSpace = cut.lastIndexOf(' ');\n  return cut.slice(0, lastSpace > 100 ? lastSpace : max).trim() + '…';\n}\n\nconst now = Date.now();\nconst out = [];\n\nfor (const item of $input.all()) {\n  const j = item.json;\n  const content = cleanText(j.content);\n  const haystack = (String(j.title || '') + ' ' + content).toLowerCase();\n\n  let score = CONFIG.baseBySource[j.source] ?? CONFIG.defaultBase;\n\n  for (const b of CONFIG.boosts) if (b.re.test(haystack)) score += b.pts;\n  for (const p of CONFIG.penalties) if (p.re.test(haystack)) score += p.pts;\n  for (const r of CONFIG.sourceRules) {\n    if (j.source === r.source && r.re.test(j.title || '')) score += r.pts;\n  }\n\n  const ageH = (now - new Date(j.published_at).getTime()) / 36e5;\n  for (const r of CONFIG.recency) {\n    if (ageH >= 0 && ageH <= r.maxHours) { score += r.pts; break; }\n  }\n\n  const cap = CONFIG.maxBySource[j.source] ?? 10;\n  const importance = Math.max(1, Math.min(cap, Math.round(score)));\n\n  let category = CONFIG.categoryByType[j.type] || 'Policy/Other';\n  if (j.source === 'CISA KEV') {\n    category = 'Exploit/Zero-day';\n  } else if (j.type === 'tool') {\n    category = 'Tool';\n  } else {\n    for (const c of CONFIG.categories) {\n      if (c.re.test(haystack)) { category = c.name; break; }\n    }\n  }\n\n  out.push({\n    json: {\n      ...j,\n      category,\n      importance,\n      summary: makeSummary(content, CONFIG.summaryLength),\n    },\n  });\n}\n\nreturn out;"
      },
